root = true

# Base: what `dotnet new editorconfig` assumes for any text file in a .NET repo.
[*]
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

# Config, workflow and project files nest deeply; two spaces keeps them readable.
[*.{json,yml,yaml,csproj,props,targets,md}]
indent_size = 2

# A Markdown line ending in two spaces is a hard break, so leave those alone.
[*.md]
trim_trailing_whitespace = false

# C#: the template defaults apply, with two exceptions that match how the code is written. Everything
# else the old file listed was either a default already or only an IDE hint, and
# `dotnet format --verify-no-changes` passes without it.
[*.cs]
# Braced namespaces in every file; do not offer to convert them to the file-scoped form.
csharp_style_namespace_declarations = block_scoped:silent
# Usings keep the order they were written in; System.* is not pulled to the top.
dotnet_sort_system_directives_first = false
