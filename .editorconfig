# OLED Protect code style. `dotnet format` and the IDE both read this file.
root = true

# ---- everything ----
[*]
indent_style = space
indent_size = 4
trim_trailing_whitespace = true

# ---- data and docs: two-space indent ----
[*.{yml,yaml,json,md}]
indent_size = 2

[*.{csproj,props,targets}]
indent_size = 2

# Markdown uses two trailing spaces as a line break.
[*.md]
trim_trailing_whitespace = false

[*.xaml]
indent_size = 4

# ---- C# ----
[*.cs]
indent_size = 4

# Block namespaces, `using`s above them, in written order.
csharp_style_namespace_declarations = block_scoped:suggestion
csharp_using_directive_placement = outside_namespace:suggestion
dotnet_sort_system_directives_first = false

# Preferred forms, offered as hints only.
csharp_prefer_braces = when_multiline:suggestion
csharp_style_prefer_primary_constructors = true:suggestion
csharp_style_expression_bodied_properties = true:suggestion
csharp_style_expression_bodied_methods = when_on_single_line:suggestion
csharp_style_throw_expression = true:suggestion
csharp_style_pattern_matching_over_is_with_cast_check = true:suggestion

# `var` or an explicit type: left to the author.
csharp_style_var_elsewhere = false:silent
csharp_style_var_for_built_in_types = false:silent
csharp_style_var_when_type_is_apparent = true:silent

# Whitespace issues are fixed by `dotnet format`, so they do not show up as build warnings.
dotnet_diagnostic.IDE0055.severity = suggestion
