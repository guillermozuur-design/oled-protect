<Application x:Class="OLED_Sleeper.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Application.Resources>
        <!-- ===== Palette: near-black (OLED-friendly) with a soft moonlight accent ===== -->
        <SolidColorBrush x:Key="PrimaryBackgroundColor" Color="#08090C" />
        <SolidColorBrush x:Key="SecondaryBackgroundColor" Color="#111319" />
        <SolidColorBrush x:Key="TertiaryBackgroundColor" Color="#1B1E27" />
        <SolidColorBrush x:Key="PrimaryForegroundColor" Color="#ECEEF4" />
        <SolidColorBrush x:Key="SecondaryForegroundColor" Color="#8B91A1" />
        <SolidColorBrush x:Key="AccentColorBrush" Color="#7FA7FF" />
        <SolidColorBrush x:Key="AccentSoftBrush" Color="#1A2540" />
        <SolidColorBrush x:Key="StarGoldBrush" Color="#F3D48C" />
        <SolidColorBrush x:Key="DestructiveColorBrush" Color="#FF5A6A" />
        <SolidColorBrush x:Key="SeparatorColorBrush" Color="#272B37" />

        <!-- ===== A card: the rounded panel every section sits in ===== -->
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource SecondaryBackgroundColor}" />
            <Setter Property="BorderBrush" Value="{StaticResource SeparatorColorBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="Padding" Value="18,14" />
            <Setter Property="Margin" Value="0,0,0,12" />
        </Style>

        <Style x:Key="CardTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="15" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{StaticResource PrimaryForegroundColor}" />
        </Style>

        <Style x:Key="CardText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Margin" Value="0,3,0,0" />
            <Setter Property="Foreground" Value="{StaticResource SecondaryForegroundColor}" />
        </Style>

        <!-- ===== Toggle switch (a restyled CheckBox) ===== -->
        <Style x:Key="Switch" TargetType="CheckBox">
            <Setter Property="Foreground" Value="{StaticResource PrimaryForegroundColor}" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <StackPanel Orientation="Horizontal" Background="Transparent">
                            <Grid Width="38" Height="22" VerticalAlignment="Center">
                                <Border x:Name="Track" CornerRadius="11" Background="{StaticResource TertiaryBackgroundColor}"
                                        BorderBrush="{StaticResource SeparatorColorBrush}" BorderThickness="1" />
                                <Ellipse x:Name="Knob" Width="16" Height="16" HorizontalAlignment="Left" Margin="3,0,0,0"
                                         Fill="{StaticResource SecondaryForegroundColor}" />
                            </Grid>
                            <ContentPresenter Margin="10,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Track" Property="Background" Value="{StaticResource AccentColorBrush}" />
                                <Setter TargetName="Track" Property="BorderBrush" Value="{StaticResource AccentColorBrush}" />
                                <Setter TargetName="Knob" Property="Fill" Value="#08090C" />
                                <Setter TargetName="Knob" Property="HorizontalAlignment" Value="Right" />
                                <Setter TargetName="Knob" Property="Margin" Value="0,0,3,0" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ===== Buttons ===== -->
        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Foreground" Value="#08090C" />
            <Setter Property="Background" Value="{StaticResource AccentColorBrush}" />
            <Setter Property="FontSize" Value="13.5" />
            <Setter Property="Padding" Value="16,7" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.88" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SubtleButton" TargetType="Button">
            <Setter Property="Foreground" Value="{StaticResource PrimaryForegroundColor}" />
            <Setter Property="Background" Value="{StaticResource TertiaryBackgroundColor}" />
            <Setter Property="BorderBrush" Value="{StaticResource SeparatorColorBrush}" />
            <Setter Property="FontSize" Value="13.5" />
            <Setter Property="Padding" Value="14,6" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="1" CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource AccentColorBrush}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ===== Text field ===== -->
        <Style x:Key="Field" TargetType="TextBox">
            <Setter Property="Background" Value="{StaticResource TertiaryBackgroundColor}" />
            <Setter Property="Foreground" Value="{StaticResource PrimaryForegroundColor}" />
            <Setter Property="BorderBrush" Value="{StaticResource SeparatorColorBrush}" />
            <Setter Property="CaretBrush" Value="{StaticResource PrimaryForegroundColor}" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Height" Value="32" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="1" CornerRadius="8" Padding="6,0">
                            <ScrollViewer x:Name="PART_ContentHost" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource AccentColorBrush}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ===== Tabs: plain text with a moonlight underline ===== -->
        <Style x:Key="Tabs" TargetType="TabControl">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabControl">
                        <DockPanel>
                            <Border DockPanel.Dock="Top" BorderBrush="{StaticResource SeparatorColorBrush}" BorderThickness="0,0,0,1" Margin="22,0,22,0">
                                <TabPanel IsItemsHost="True" />
                            </Border>
                            <ContentPresenter ContentSource="SelectedContent" Margin="22,16,22,0" />
                        </DockPanel>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="TabItem">
            <Setter Property="Foreground" Value="{StaticResource SecondaryForegroundColor}" />
            <Setter Property="FontSize" Value="14.5" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Grid Margin="0,0,26,0" Background="Transparent">
                            <ContentPresenter ContentSource="Header" Margin="0,10,0,10" />
                            <Border x:Name="Line" Height="2" VerticalAlignment="Bottom" CornerRadius="1" Background="Transparent" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Line" Property="Background" Value="{StaticResource AccentColorBrush}" />
                                <Setter Property="Foreground" Value="{StaticResource PrimaryForegroundColor}" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="{StaticResource PrimaryForegroundColor}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Dark, readable tooltips everywhere -->
        <Style TargetType="ToolTip">
            <Setter Property="Foreground" Value="{StaticResource PrimaryForegroundColor}" />
            <Setter Property="Background" Value="{StaticResource TertiaryBackgroundColor}" />
            <Setter Property="BorderBrush" Value="{StaticResource SeparatorColorBrush}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Padding" Value="9,6" />
        </Style>
    </Application.Resources>
</Application>
