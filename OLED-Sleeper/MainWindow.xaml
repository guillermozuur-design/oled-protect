<Window x:Class="OLED_Sleeper.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:converters="clr-namespace:OLED_Sleeper.UI.Converters"
        xmlns:viewModels1="clr-namespace:OLED_Sleeper.UI.ViewModels"
        xmlns:views="clr-namespace:OLED_Sleeper.UI.Views"
        xmlns:sky="clr-namespace:OLED_Sleeper.Features.Sky"
        mc:Ignorable="d"
        Title="OLED Space Sleeper"
        d:DataContext="{d:DesignInstance viewModels1:MainViewModel}"
        Height="900" Width="860" MinHeight="700" MinWidth="760"
        FontFamily="Bahnschrift"
        Background="{StaticResource PrimaryBackgroundColor}"
        WindowStyle="None"
        AllowsTransparency="True"
        WindowChrome.IsHitTestVisibleInChrome="True"
        Icon="/Assets/icon.ico">

    <Window.Resources>
        <converters:BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
        <converters:NullToVisibilityConverter x:Key="NullToVisibilityConverter" IsReversed="False" />
        <converters:NullToVisibilityConverter x:Key="NotNullToVisibilityConverter" IsReversed="True" />

        <Style x:Key="WindowButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{StaticResource SecondaryForegroundColor}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Width" Value="46" />
            <Setter Property="Height" Value="34" />
            <Setter Property="FontFamily" Value="Segoe MDL2 Assets" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{StaticResource TertiaryBackgroundColor}" />
                    <Setter Property="Foreground" Value="{StaticResource PrimaryForegroundColor}" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="CloseButtonStyle" TargetType="Button" BasedOn="{StaticResource WindowButtonStyle}">
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{StaticResource DestructiveColorBrush}" />
                    <Setter Property="Foreground" Value="White" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="LoadingProgressBarStyle" TargetType="ProgressBar">
            <Setter Property="Foreground" Value="{StaticResource AccentColorBrush}" />
            <Setter Property="Background" Value="{StaticResource TertiaryBackgroundColor}" />
            <Setter Property="Height" Value="6" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ProgressBar">
                        <Border CornerRadius="3" Background="{TemplateBinding Background}" ClipToBounds="True">
                            <Rectangle x:Name="Bar" Width="90" HorizontalAlignment="Left" Fill="{TemplateBinding Foreground}" RadiusX="3" RadiusY="3">
                                <Rectangle.RenderTransform>
                                    <TranslateTransform X="-90" />
                                </Rectangle.RenderTransform>
                            </Rectangle>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsIndeterminate" Value="True">
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard RepeatBehavior="Forever">
                                            <DoubleAnimation Storyboard.TargetName="Bar"
                                                             Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)"
                                                             From="-90" To="300" Duration="0:0:1.6" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="ModernSlider" TargetType="Slider">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Slider">
                        <Grid>
                            <Border x:Name="Track" Height="4" Background="{StaticResource TertiaryBackgroundColor}" CornerRadius="2" />
                            <Canvas>
                                <Border x:Name="PART_SelectionRange" Background="{StaticResource AccentColorBrush}" Height="4" CornerRadius="2" />
                            </Canvas>
                            <Track x:Name="PART_Track">
                                <Track.Thumb>
                                    <Thumb x:Name="Thumb" Width="16" Height="16" Background="{StaticResource PrimaryForegroundColor}" BorderBrush="{StaticResource SecondaryForegroundColor}" BorderThickness="1">
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Ellipse Fill="{TemplateBinding Background}" Stroke="{TemplateBinding BorderBrush}" StrokeThickness="{TemplateBinding BorderThickness}" />
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.5" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Thumb" Property="BorderBrush" Value="{StaticResource AccentColorBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border BorderBrush="{StaticResource SeparatorColorBrush}" BorderThickness="1">
        <Grid>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="34" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- ===== Title bar ===== -->
                <Grid Grid.Row="0" Background="Transparent" MouseDown="TitleBar_MouseDown">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="14,0,0,0">
                        <Image Source="/Assets/icon.ico" Width="16" Height="16" />
                        <TextBlock Text="OLED Space Sleeper" Foreground="{StaticResource SecondaryForegroundColor}" FontSize="12.5" Margin="9,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Style="{StaticResource WindowButtonStyle}" Content="&#xE921;" Click="MinimizeButton_Click" ToolTip="Minimaliseren" />
                        <Button Style="{StaticResource WindowButtonStyle}" Content="&#xE922;" Click="MaximizeButton_Click" ToolTip="Maximaliseren" />
                        <Button Style="{StaticResource CloseButtonStyle}" Content="&#xE8BB;" Click="CloseButton_Click" ToolTip="Naar het systeemvak (blijft actief)" />
                    </StackPanel>
                </Grid>

                <!-- ===== Personal header ===== -->
                <Grid Grid.Row="1" Margin="22,6,22,14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock x:Name="GreetingText" FontSize="26" FontWeight="SemiBold" Foreground="{StaticResource PrimaryForegroundColor}" Text="Bescherming actief" />
                        <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                            <Ellipse x:Name="StatusDot" Width="8" Height="8" Fill="{StaticResource AccentColorBrush}" VerticalAlignment="Center" />
                            <TextBlock x:Name="StatusText" FontSize="13.5" Margin="8,0,0,0" Foreground="{StaticResource SecondaryForegroundColor}" />
                        </StackPanel>
                        <TextBlock x:Name="ScheduleText" FontSize="12.5" Margin="16,3,0,0" Foreground="{StaticResource SecondaryForegroundColor}" Visibility="Collapsed" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Right">
                        <Button x:Name="WorkModeButton" Style="{StaticResource SubtleButton}" Click="WorkMode_Click" Padding="16,9">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock x:Name="WorkModeIcon" FontFamily="Segoe MDL2 Assets" Text="&#xE7F4;" FontSize="15" VerticalAlignment="Center" />
                                <TextBlock x:Name="WorkModeLabel" Text="Werkmodus aan" Margin="9,0,0,0" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <TextBlock x:Name="HotkeyHint" FontSize="11.5" Margin="0,6,0,0" HorizontalAlignment="Center" Foreground="{StaticResource SecondaryForegroundColor}" />
                    </StackPanel>
                </Grid>

                <!-- ===== Tabs ===== -->
                <TabControl x:Name="MainTabs" Grid.Row="2" Style="{StaticResource Tabs}" SelectionChanged="MainTabs_SelectionChanged">

                    <!-- ===== Schermen ===== -->
                    <TabItem Header="Schermen">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="200" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <Border Grid.Row="0" Style="{StaticResource Card}" Padding="8">
                                <views:MonitorLayoutView />
                            </Border>

                            <Border Grid.Row="1" Style="{StaticResource Card}" Padding="0" Margin="0,0,0,12"
                                    Visibility="{Binding SelectedMonitor, Converter={StaticResource NotNullToVisibilityConverter}}">
                                <ScrollViewer VerticalScrollBarVisibility="Auto">
                                    <views:MonitorConfigurationView DataContext="{Binding SelectedMonitor.Configuration}" />
                                </ScrollViewer>
                            </Border>

                            <Border Grid.Row="1" Style="{StaticResource Card}"
                                    Visibility="{Binding SelectedMonitor, Converter={StaticResource NullToVisibilityConverter}}">
                                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE7F4;" FontSize="28" HorizontalAlignment="Center" Foreground="{StaticResource AccentColorBrush}" />
                                    <TextBlock Text="Kies hierboven een scherm om in te stellen" FontSize="15" Margin="0,10,0,0" HorizontalAlignment="Center" Foreground="{StaticResource SecondaryForegroundColor}" />
                                </StackPanel>
                            </Border>
                        </Grid>
                    </TabItem>

                    <!-- ===== Sterrenhemel ===== -->
                    <TabItem Header="Sterrenhemel">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel>
                                <Border Style="{StaticResource Card}" Padding="0" Height="230" ClipToBounds="True" Background="Black">
                                    <Grid>
                                        <sky:SkyView x:Name="SkyPreview" />
                                        <TextBlock Text="De hemel van vandaag boven Nederland" Margin="16,12,0,0" FontSize="12" Foreground="#6E7486" />
                                    </Grid>
                                </Border>

                                <Border Style="{StaticResource Card}">
                                    <DockPanel>
                                        <Button DockPanel.Dock="Right" Style="{StaticResource PrimaryButton}" Content="Bekijk op dit scherm" Click="PreviewSky_Click" VerticalAlignment="Center" />
                                        <StackPanel>
                                            <TextBlock Text="Sterrenhemel als screensaver" Style="{StaticResource CardTitle}" />
                                            <TextBlock Style="{StaticResource CardText}"
                                                       Text="Kies bij een scherm 'Sterren' als gedrag. Echte sterren, sterrenbeelden, planeten en de maan van vandaag; alles beweegt langzaam, dus er kan niets inbranden. Muis bewegen of een toets indrukken stopt het voorbeeld." />
                                        </StackPanel>
                                    </DockPanel>
                                </Border>

                                <Border Style="{StaticResource Card}">
                                    <StackPanel>
                                        <DockPanel>
                                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                                <TextBox x:Name="GapBox" Style="{StaticResource Field}" Width="64"
                                                         LostKeyboardFocus="GapBox_LostFocus" KeyDown="GapBox_KeyDown"
                                                         ToolTip="De afstand tussen het beeld van het ene en het andere scherm (beide randen samen)." />
                                                <TextBlock Text="cm" Margin="8,0,14,0" FontSize="14" VerticalAlignment="Center" Foreground="{StaticResource PrimaryForegroundColor}" />
                                                <Button Content="Kalibreren" Style="{StaticResource SubtleButton}" Click="Calibrate_Click"
                                                        ToolTip="Schuine lijnen over beide schermen: schuif tot ze recht doorlopen over de rand." />
                                            </StackPanel>
                                            <StackPanel>
                                                <TextBlock Text="Ruimte tussen de schermen" Style="{StaticResource CardTitle}" />
                                                <TextBlock x:Name="GapStatus" Style="{StaticResource CardText}"
                                                           Text="Zo lopen sterren en vallende sterren 'achter de rand langs' van het ene naar het andere scherm." />
                                            </StackPanel>
                                        </DockPanel>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>

                    <!-- ===== Vliegtuigen ===== -->
                    <TabItem Header="Vliegtuigen" x:Name="FlightsTab">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel>
                                <Border Style="{StaticResource Card}" Padding="0" Height="230" ClipToBounds="True" Background="Black">
                                    <Grid>
                                        <ContentControl x:Name="FlightsPreviewHost" />
                                        <TextBlock x:Name="FlightsPreviewCaption" Margin="16,12,0,0" FontSize="12" Foreground="#6E7486" />
                                    </Grid>
                                </Border>

                                <Border Style="{StaticResource Card}">
                                    <DockPanel>
                                        <Button DockPanel.Dock="Right" Style="{StaticResource PrimaryButton}" Content="Bekijk op alle schermen" Click="PreviewFlights_Click" VerticalAlignment="Center" />
                                        <StackPanel>
                                            <TextBlock Text="Vliegtuigen als screensaver" Style="{StaticResource CardTitle}" />
                                            <TextBlock Style="{StaticResource CardText}"
                                                       Text="Kies bij een scherm 'Vliegtuigen' als gedrag. Een donkere kaart met wegen, water en plaatsen, en de echte vliegtuigen van dit moment erboven. De kaart drijft, draait en zoomt heel langzaam en start elke keer ergens anders, dus er kan niets inbranden." />
                                        </StackPanel>
                                    </DockPanel>
                                </Border>

                                <Border Style="{StaticResource Card}">
                                    <StackPanel>
                                        <DockPanel>
                                            <CheckBox x:Name="TourCheck" DockPanel.Dock="Right" Style="{StaticResource Switch}" Click="Tour_Click" VerticalAlignment="Center" />
                                            <StackPanel>
                                                <TextBlock Text="Rondreis langs drukke vliegvelden" Style="{StaticResource CardTitle}" />
                                                <TextBlock Style="{StaticResource CardText}" Text="Elke keer na een paar seconden fadet het beeld naar een ander vliegveld in de landen hieronder, zodat er altijd wat te zien is. Uit: altijd rond je speldje." />
                                            </StackPanel>
                                        </DockPanel>

                                        <StackPanel x:Name="TourOptions" Margin="0,14,0,0">
                                            <DockPanel>
                                                <TextBox x:Name="CountriesBox" DockPanel.Dock="Right" Style="{StaticResource Field}" Width="330" VerticalAlignment="Center"
                                                         TextChanged="CountriesBox_TextChanged" ToolTip="Bijvoorbeeld: Nederland, België, Spanje, Verenigd Koninkrijk" />
                                                <StackPanel>
                                                    <TextBlock Text="Landen" Style="{StaticResource CardTitle}" />
                                                    <TextBlock x:Name="CountriesStatus" Style="{StaticResource CardText}" />
                                                </StackPanel>
                                            </DockPanel>

                                            <DockPanel Margin="0,14,0,0">
                                                <CheckBox x:Name="FollowCheck" DockPanel.Dock="Right" Style="{StaticResource Switch}" Click="Follow_Click" VerticalAlignment="Center" />
                                                <StackPanel>
                                                    <TextBlock Text="Af en toe een vlucht volgen" Style="{StaticResource CardTitle}" />
                                                    <TextBlock Style="{StaticResource CardText}" Text="Om de paar vliegvelden volgt hij een tijdje één vliegtuig dat daar vliegt, met vluchtnummer, route, type, hoogte en snelheid." />
                                                </StackPanel>
                                            </DockPanel>

                                            <DockPanel Margin="0,14,0,0">
                                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                                    <Slider x:Name="SceneSlider" Style="{StaticResource ModernSlider}" Width="200" Minimum="10" Maximum="60" TickFrequency="5" IsSnapToTickEnabled="True"
                                                            VerticalAlignment="Center" ValueChanged="SceneSlider_ValueChanged" />
                                                    <TextBlock x:Name="SceneText" Width="56" Margin="12,0,0,0" FontSize="14" VerticalAlignment="Center" Foreground="{StaticResource PrimaryForegroundColor}" />
                                                </StackPanel>
                                                <StackPanel>
                                                    <TextBlock Text="Tijd per beeld" Style="{StaticResource CardTitle}" />
                                                    <TextBlock Style="{StaticResource CardText}" Text="Hoe lang een vliegveld of vlucht in beeld blijft." />
                                                </StackPanel>
                                            </DockPanel>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>

                                <Border Style="{StaticResource Card}">
                                    <StackPanel>
                                        <DockPanel>
                                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                                <TextBox x:Name="PlaceBox" Style="{StaticResource Field}" Width="210" KeyDown="PlaceBox_KeyDown"
                                                         ToolTip="Een plaats, adres of postcode, of coördinaten zoals 52.09, 5.12" />
                                                <Button x:Name="PlaceSearchButton" Content="Zoeken" Style="{StaticResource SubtleButton}" Margin="10,0,0,0" Click="PlaceSearch_Click" />
                                            </StackPanel>
                                            <StackPanel>
                                                <TextBlock Text="Plek van je speldje" Style="{StaticResource CardTitle}" />
                                                <TextBlock x:Name="PlaceStatus" Style="{StaticResource CardText}" />
                                            </StackPanel>
                                        </DockPanel>
                                    </StackPanel>
                                </Border>

                                <Border Style="{StaticResource Card}">
                                    <DockPanel>
                                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                            <Slider x:Name="RadiusSlider" Style="{StaticResource ModernSlider}" Width="200" Minimum="15" Maximum="80" TickFrequency="5" IsSnapToTickEnabled="True"
                                                    VerticalAlignment="Center" ValueChanged="RadiusSlider_ValueChanged" />
                                            <TextBlock x:Name="RadiusText" Width="56" Margin="12,0,0,0" FontSize="14" VerticalAlignment="Center" Foreground="{StaticResource PrimaryForegroundColor}" />
                                        </StackPanel>
                                        <StackPanel>
                                            <TextBlock Text="Hoe ver om het speldje heen" Style="{StaticResource CardTitle}" />
                                            <TextBlock Style="{StaticResource CardText}" Text="Kleiner = meer details en grotere plaatsnamen; groter = meer vliegtuigen." />
                                        </StackPanel>
                                    </DockPanel>
                                </Border>

                                <Border Style="{StaticResource Card}">
                                    <DockPanel>
                                        <CheckBox x:Name="FlightLabelsCheck" DockPanel.Dock="Right" Style="{StaticResource Switch}" Click="FlightLabels_Click" VerticalAlignment="Center" />
                                        <StackPanel>
                                            <TextBlock Text="Vluchtnummer en hoogte bij elk vliegtuig" Style="{StaticResource CardTitle}" />
                                            <TextBlock Style="{StaticResource CardText}" Text="Kleur van het vliegtuig: oranje = laag (opstijgen of landen), lichtblauw = hoog." />
                                        </StackPanel>
                                    </DockPanel>
                                </Border>

                                <TextBlock Margin="6,2,6,14" FontSize="11.5" TextWrapping="Wrap" Foreground="{StaticResource SecondaryForegroundColor}"
                                           Text="Kaart: © OpenStreetMap-bijdragers, via OpenFreeMap / OpenMapTiles. Vliegtuigen: adsb.fi en adsb.lol (open ADS-B-data), routes: adsbdb.com, vliegvelden: OurAirports. Zoeken: Nominatim (OpenStreetMap). De coördinaten van het speldje en de vliegvelden worden naar deze diensten gestuurd om de gegevens rond die plek op te halen; ze blijven verder alleen op deze pc." />
                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>

                    <!-- ===== Algemeen ===== -->
                    <TabItem Header="Algemeen">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel>
                                <Border Style="{StaticResource Card}">
                                    <DockPanel>
                                        <TextBox x:Name="HotkeyBox" DockPanel.Dock="Right" Style="{StaticResource Field}" Width="150" IsReadOnly="True" Cursor="Hand"
                                                 CaretBrush="Transparent" VerticalAlignment="Center"
                                                 GotKeyboardFocus="HotkeyBox_GotFocus" LostKeyboardFocus="HotkeyBox_LostFocus"
                                                 PreviewKeyDown="HotkeyBox_PreviewKeyDown"
                                                 ToolTip="Klik hier en druk de combinatie die je wilt gebruiken (met Ctrl, Alt, Shift of Win)." />
                                        <StackPanel>
                                            <TextBlock Text="Sneltoets snelmenu" Style="{StaticResource CardTitle}" />
                                            <TextBlock x:Name="HotkeyStatus" Style="{StaticResource CardText}"
                                                       Text="Ingedrukt houden, tikken = volgende keuze, loslaten = kiezen." />
                                        </StackPanel>
                                    </DockPanel>
                                </Border>

                                <Border Style="{StaticResource Card}">
                                    <StackPanel>
                                        <DockPanel>
                                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                                <TextBox x:Name="GlobalIdleBox" Style="{StaticResource Field}" Width="56"
                                                         LostKeyboardFocus="GlobalIdleBox_LostFocus" KeyDown="GlobalIdleBox_KeyDown" />
                                                <TextBlock Text="min" Margin="8,0,16,0" FontSize="14" VerticalAlignment="Center" Foreground="{StaticResource PrimaryForegroundColor}" />
                                                <CheckBox x:Name="GlobalIdleCheck" Style="{StaticResource Switch}" Click="GlobalIdle_Changed" VerticalAlignment="Center" />
                                            </StackPanel>
                                            <StackPanel>
                                                <TextBlock Text="Alle schermen uit als je weg bent" Style="{StaticResource CardTitle}" />
                                                <TextBlock x:Name="GlobalIdleStatus" Style="{StaticResource CardText}"
                                                           Text="Na deze tijd zonder muis of toets gaan alle bewaakte schermen naar hun stand. Speelt er een video, dan blijft het scherm met die video aan." />
                                            </StackPanel>
                                        </DockPanel>
                                    </StackPanel>
                                </Border>

                                <Border Style="{StaticResource Card}">
                                    <StackPanel>
                                        <DockPanel>
                                            <Button DockPanel.Dock="Right" x:Name="AddAppButton" Content="+ Andere app kiezen" Style="{StaticResource SubtleButton}"
                                                    Click="AddApp_Click" VerticalAlignment="Top" />
                                            <StackPanel>
                                                <TextBlock Text="Apps die het scherm aan houden" Style="{StaticResource CardTitle}" />
                                                <TextBlock Style="{StaticResource CardText}"
                                                           Text="Zolang een aangevinkte app openstaat, blijft het scherm waar hij op staat aan (of alle schermen) — ook als een timer verloopt." />
                                            </StackPanel>
                                        </DockPanel>
                                        <StackPanel x:Name="AppRows" Margin="0,12,0,0" />
                                    </StackPanel>
                                </Border>

                                <Border Style="{StaticResource Card}">
                                    <DockPanel>
                                        <CheckBox x:Name="StartupCheck" DockPanel.Dock="Right" Style="{StaticResource Switch}" Click="Startup_Click" VerticalAlignment="Center" />
                                        <StackPanel>
                                            <TextBlock Text="Starten met Windows" Style="{StaticResource CardTitle}" />
                                            <TextBlock Style="{StaticResource CardText}" Text="Start verborgen in het systeemvak bij het inloggen." />
                                        </StackPanel>
                                    </DockPanel>
                                </Border>

                                <Border Style="{StaticResource Card}">
                                    <StackPanel>
                                        <TextBlock Text="Tip" Style="{StaticResource CardTitle}" />
                                        <TextBlock Style="{StaticResource CardText}"
                                                   Text="Zet in Windows (Instellingen → Systeem → Energie) 'Scherm uitschakelen' op Nooit of veel langer; OLED Space Sleeper regelt het dan per scherm." />
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>
                </TabControl>

                <!-- ===== Footer ===== -->
                <Border Grid.Row="3" BorderBrush="{StaticResource SeparatorColorBrush}" BorderThickness="0,1,0,0" Padding="22,9">
                    <DockPanel>
                        <TextBlock x:Name="VersionText" DockPanel.Dock="Right" FontSize="11.5" Foreground="#5C6272" />
                        <TextBlock x:Name="SaveStatusText" FontSize="12" Foreground="{StaticResource SecondaryForegroundColor}"
                                   Text="Wijzigingen worden automatisch opgeslagen" />
                    </DockPanel>
                </Border>
            </Grid>

            <Grid Background="#C008090C"
                  Visibility="{Binding IsLoading, Converter={StaticResource BooleanToVisibilityConverter}, FallbackValue=Collapsed}">
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                    <ProgressBar Style="{StaticResource LoadingProgressBarStyle}" IsIndeterminate="True" Width="220" />
                    <TextBlock Text="Schermen zoeken…" Foreground="{StaticResource SecondaryForegroundColor}" FontSize="14"
                               Margin="0,14,0,0" HorizontalAlignment="Center" />
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</Window>
