<UserControl x:Class="OLED_Sleeper.UI.Views.MonitorConfigurationView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:behavior="clr-namespace:OLED_Sleeper.Features.MonitorBehavior.Models"
             xmlns:conv="clr-namespace:OLED_Sleeper.UI.Converters"
             xmlns:vm="clr-namespace:OLED_Sleeper.UI.ViewModels"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:MonitorConfigurationViewModel}"
             FontFamily="Bahnschrift"
             ToolTipService.InitialShowDelay="200">

    <!-- Settings for the one screen picked in the overview. -->
    <UserControl.Resources>
        <conv:EnumToBooleanConverter x:Key="IsBehavior" />
        <conv:TimeUnitToTextConverter x:Key="UnitName" />
        <conv:StringNullOrEmptyToVisibilityConverter x:Key="ShowWhenText" />

        <!-- Small grey caps above each group. -->
        <Style x:Key="GroupLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="Light" />
            <Setter Property="Foreground" Value="{StaticResource SecondaryForegroundColor}" />
        </Style>

        <!-- Red asterisk next to a label whose group still has a problem. -->
        <Style x:Key="ProblemMark" TargetType="TextBlock">
            <Setter Property="Text" Value="*" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Margin" Value="4,-2,0,0" />
            <Setter Property="VerticalAlignment" Value="Top" />
            <Setter Property="Foreground" Value="{StaticResource DestructiveColorBrush}" />
        </Style>

        <Style x:Key="Tick" TargetType="CheckBox">
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Foreground" Value="{StaticResource PrimaryForegroundColor}" />
            <Setter Property="FocusVisualStyle" Value="{StaticResource AccentFocus}" />
            <Setter Property="ToolTipService.ShowOnDisabled" Value="True" />
            <Setter Property="Validation.ErrorTemplate" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Grid Background="Transparent">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border x:Name="Square" Width="18" Height="18" CornerRadius="4" BorderThickness="1.5"
                                    Background="Transparent" BorderBrush="{StaticResource SecondaryForegroundColor}">
                                <Path x:Name="Tickmark" Margin="3" Stretch="Uniform" Visibility="Hidden"
                                      Data="M 1,6 L 5,10 L 12,2" StrokeThickness="2.2" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                      Stroke="{StaticResource PrimaryBackgroundColor}" />
                            </Border>
                            <ContentPresenter Grid.Column="1" Margin="9,0,0,0" VerticalAlignment="Center" RecognizesAccessKey="True" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Square" Property="Background" Value="{StaticResource AccentColorBrush}" />
                                <Setter TargetName="Square" Property="BorderBrush" Value="{StaticResource AccentColorBrush}" />
                                <Setter TargetName="Tickmark" Property="Visibility" Value="Visible" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Square" Property="BorderBrush" Value="{StaticResource AccentColorBrush}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="Choice" TargetType="RadioButton">
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Margin" Value="0,0,24,0" />
            <Setter Property="GroupName" Value="ScreenBehavior" />
            <Setter Property="Foreground" Value="{StaticResource PrimaryForegroundColor}" />
            <Setter Property="FocusVisualStyle" Value="{StaticResource AccentFocus}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <DockPanel Background="Transparent" LastChildFill="True">
                            <Grid DockPanel.Dock="Left" Width="18" Height="18">
                                <Ellipse x:Name="Ring" StrokeThickness="1.5" Stroke="{StaticResource SecondaryForegroundColor}" />
                                <Ellipse x:Name="Dot" Width="8" Height="8" Fill="{StaticResource AccentColorBrush}" Visibility="Hidden" />
                            </Grid>
                            <ContentPresenter VerticalAlignment="Center" Margin="9,0,0,0" />
                        </DockPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Ring" Property="Stroke" Value="{StaticResource AccentColorBrush}" />
                                <Setter TargetName="Dot" Property="Visibility" Value="Visible" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Ring" Property="Stroke" Value="{StaticResource AccentColorBrush}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="LevelSlider" TargetType="Slider">
            <Setter Property="Minimum" Value="0" />
            <Setter Property="Maximum" Value="100" />
            <Setter Property="SmallChange" Value="1" />
            <Setter Property="LargeChange" Value="10" />
            <Setter Property="IsMoveToPointEnabled" Value="True" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Slider">
                        <Grid Height="20">
                            <Border Height="4" CornerRadius="2" VerticalAlignment="Center" Background="{StaticResource TertiaryBackgroundColor}" />
                            <Track x:Name="PART_Track">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="Slider.DecreaseLarge" Focusable="False">
                                        <RepeatButton.Template>
                                            <!-- The part left of the knob is the filled part of the bar. -->
                                            <ControlTemplate TargetType="RepeatButton">
                                                <Grid Background="Transparent">
                                                    <Border Height="4" CornerRadius="2" VerticalAlignment="Center" Background="{StaticResource AccentColorBrush}" />
                                                </Grid>
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.DecreaseRepeatButton>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="Slider.IncreaseLarge" Focusable="False">
                                        <RepeatButton.Template>
                                            <ControlTemplate TargetType="RepeatButton">
                                                <Grid Background="Transparent" />
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.IncreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb x:Name="Knob" Width="16" Height="16">
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Ellipse x:Name="Face" Fill="{StaticResource PrimaryForegroundColor}"
                                                         Stroke="{StaticResource SecondaryForegroundColor}" StrokeThickness="1" />
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="Face" Property="Stroke" Value="{StaticResource AccentColorBrush}" />
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- The shared text field, minus WPF's red error frame: problems are shown as text instead. -->
        <Style x:Key="NumberField" TargetType="TextBox" BasedOn="{StaticResource Field}">
            <Setter Property="Validation.ErrorTemplate" Value="{x:Null}" />
        </Style>
    </UserControl.Resources>

    <StackPanel Margin="25,20">
        <CheckBox Style="{StaticResource Switch}"
                  Content="{Binding MonitorTitle}"
                  IsChecked="{Binding IsManaged, UpdateSourceTrigger=PropertyChanged}"
                  FontSize="18" FontWeight="SemiBold"
                  ToolTip="Zet aan om dit scherm te laten bewaken tegen inbranden." />

        <Rectangle Height="1" Margin="0,14,0,26" Fill="{StaticResource SeparatorColorBrush}" />

        <Grid IsEnabled="{Binding IsManaged}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="40" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="20" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- What happens once the screen is idle -->
            <StackPanel Grid.Row="0" Grid.Column="0" VerticalAlignment="Center" ToolTip="{Binding BehaviorSectionTooltip}">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Style="{StaticResource GroupLabel}" Text="WAT ER GEBEURT" />
                    <TextBlock Style="{StaticResource ProblemMark}"
                               Visibility="{Binding BehaviorError, Converter={StaticResource ShowWhenText}}" />
                </StackPanel>
                <WrapPanel Margin="0,10,0,0">
                    <RadioButton Style="{StaticResource Choice}" Content="Zwart"
                                 IsChecked="{Binding Behavior, Converter={StaticResource IsBehavior}, ConverterParameter={x:Static behavior:MonitorBehaviorType.Blackout}, UpdateSourceTrigger=PropertyChanged}" />
                    <RadioButton Style="{StaticResource Choice}" Content="Dimmen"
                                        IsEnabled="{Binding Path=IsDimBehaviorEnabled}"
                                 IsChecked="{Binding Behavior, Converter={StaticResource IsBehavior}, ConverterParameter={x:Static behavior:MonitorBehaviorType.Dim}, UpdateSourceTrigger=PropertyChanged}" />
                    <RadioButton Style="{StaticResource Choice}" Content="Sterren"
                                 ToolTip="OLED-vriendelijke screensaver: zwarte hemel met twinkelende en vallende sterren."
                                 IsChecked="{Binding Behavior, Converter={StaticResource IsBehavior}, ConverterParameter={x:Static behavior:MonitorBehaviorType.Screensaver}, UpdateSourceTrigger=PropertyChanged}" />
                    <RadioButton Style="{StaticResource Choice}" Content="Vliegtuigen" Margin="0"
                                 ToolTip="Een donkere, langzaam bewegende kaart met de echte vliegtuigen erboven (instellen in het tabblad Vliegtuigen)."
                                 IsChecked="{Binding Behavior, Converter={StaticResource IsBehavior}, ConverterParameter={x:Static behavior:MonitorBehaviorType.Flights}, UpdateSourceTrigger=PropertyChanged}" />
                </WrapPanel>
                <CheckBox Style="{StaticResource Tick}" Margin="0,12,0,0" FontSize="13"
                          Content="Ook helderheid naar 0"
                          IsEnabled="{Binding IsLowerBrightnessOptionEnabled}"
                          IsChecked="{Binding LowerBrightnessOnBlackout, UpdateSourceTrigger=PropertyChanged}"
                          ToolTip="{Binding LowerBrightnessTooltip}" />
            </StackPanel>

            <!-- Brightness used by the "Dimmen" behaviour -->
            <StackPanel Grid.Row="0" Grid.Column="2" VerticalAlignment="Center"
                        IsEnabled="{Binding IsDimSliderEnabled}"
                        ToolTip="De helderheid die het scherm krijgt als het gedimd wordt.">
                <TextBlock Style="{StaticResource GroupLabel}" Text="DIMNIVEAU" />
                <DockPanel Margin="0,8,0,0">
                    <TextBlock DockPanel.Dock="Right" MinWidth="40" Margin="14,0,0,0" VerticalAlignment="Center" TextAlignment="Right"
                               Foreground="{StaticResource PrimaryForegroundColor}"
                               Text="{Binding DimLevel, StringFormat={}{0:F0}%}" />
                    <Slider Style="{StaticResource LevelSlider}" Value="{Binding DimLevel, UpdateSourceTrigger=PropertyChanged}" />
                </DockPanel>
            </StackPanel>

            <!-- Idle time -->
            <StackPanel Grid.Row="2" Grid.Column="0"
                        ToolTip="Hoe lang het scherm stil moet staan voordat het zwart wordt, dimt of een screensaver (sterren of vliegtuigen) laat zien.">
                <TextBlock Style="{StaticResource GroupLabel}" Text="WACHTTIJD" />
                <Grid Margin="0,8,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="120" />
                        <ColumnDefinition Width="10" />
                        <ColumnDefinition Width="80" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Grid.Column="0" Margin="4,0,0,3" FontSize="11" Text="Eenheid"
                               Foreground="{StaticResource SecondaryForegroundColor}" />
                    <StackPanel Grid.Row="0" Grid.Column="2" Orientation="Horizontal" Margin="4,0,0,3">
                        <TextBlock FontSize="11" Text="Waarde" Foreground="{StaticResource SecondaryForegroundColor}" />
                        <TextBlock Style="{StaticResource ProblemMark}"
                                   Visibility="{Binding IdleValueError, Converter={StaticResource ShowWhenText}}" />
                    </StackPanel>

                    <ComboBox Grid.Row="1" Grid.Column="0" Height="32" FontSize="14"
                              ItemsSource="{Binding TimeUnits}"
                              SelectedItem="{Binding SelectedTimeUnit, UpdateSourceTrigger=PropertyChanged}">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Converter={StaticResource UnitName}}" />
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                    <TextBox Grid.Row="1" Grid.Column="2" Style="{StaticResource NumberField}"
                             Text="{Binding IdleValue, UpdateSourceTrigger=PropertyChanged, TargetNullValue=''}" />
                </Grid>
            </StackPanel>

            <!-- What keeps the screen awake -->
            <StackPanel Grid.Row="2" Grid.Column="2">
                <StackPanel.ToolTip>
                    <TextBlock>
                        <Bold>Per scherm</Bold><LineBreak />
                        Deze vinkjes houden ALLEEN dit scherm wakker.<LineBreak /><LineBreak />
                        • <Bold>De muis op dit scherm:</Bold> zolang je muis hier staat.<LineBreak />
                        • <Bold>Het actieve venster op dit scherm:</Bold> het venster waar je het laatst in klikte.<LineBreak /><LineBreak />
                        <Bold>Overal</Bold><LineBreak />
                        • <Bold>Muis of toetsenbord ergens:</Bold> elke invoer, op welk scherm ook (zoals Windows zelf).
                    </TextBlock>
                </StackPanel.ToolTip>

                <StackPanel Orientation="Horizontal">
                    <TextBlock Style="{StaticResource GroupLabel}" Text="WAKKER HOUDEN ALS…" />
                    <TextBlock Style="{StaticResource ProblemMark}"
                               Visibility="{Binding ActiveConditionsError, Converter={StaticResource ShowWhenText}}" />
                </StackPanel>

                <CheckBox Style="{StaticResource Tick}" Margin="0,8,0,8" Content="de muis op dit scherm staat"
                          IsChecked="{Binding IsActiveOnMousePosition, UpdateSourceTrigger=PropertyChanged}" />
                <CheckBox Style="{StaticResource Tick}" Margin="0,0,0,8" Content="het actieve venster op dit scherm staat"
                          IsChecked="{Binding IsActiveOnActiveWindow, UpdateSourceTrigger=PropertyChanged}" />

                <!-- Refinement of the two options above, so it is indented under them. -->
                <WrapPanel Margin="27,0,0,10" IsEnabled="{Binding IsStillLimitApplicable}" ToolTipService.ShowOnDisabled="True"
                           ToolTip="Geldt voor de muis en voor het gefocuste venster hierboven: staat de muis hier, of het actieve venster,&#10;maar beweeg je de muis niet en druk je geen toets in, dan gaat dit scherm na deze tijd toch uit.&#10;Muis bewegen of een toets indrukken maakt het weer wakker.&#10;Speelt er een video (YouTube, Netflix, VLC), dan blijft het scherm met het actieve venster gewoon aan.">
                    <CheckBox Style="{StaticResource Tick}" FontSize="13" VerticalAlignment="Center" Content="maar toch uit na"
                              IsChecked="{Binding UseMouseStillLimit, UpdateSourceTrigger=PropertyChanged}" />
                    <TextBox Style="{StaticResource NumberField}" Width="46" Height="26" Margin="8,0,0,0" FontSize="13"
                             IsEnabled="{Binding UseMouseStillLimit}"
                             Text="{Binding MouseStillMinutes, UpdateSourceTrigger=PropertyChanged, TargetNullValue=''}" />
                    <TextBlock Margin="8,0,0,0" VerticalAlignment="Center" FontSize="13" Text="min zonder muis of toets"
                               Foreground="{StaticResource SecondaryForegroundColor}" />
                    <TextBlock Margin="10,0,0,0" VerticalAlignment="Center" FontSize="12"
                               Foreground="{StaticResource DestructiveColorBrush}"
                               Text="{Binding MouseStillError}"
                               Visibility="{Binding MouseStillError, Converter={StaticResource ShowWhenText}}" />
                </WrapPanel>

                <CheckBox Style="{StaticResource Tick}" Content="ik ergens muis of toetsenbord gebruik"
                          IsChecked="{Binding IsActiveOnInput, UpdateSourceTrigger=PropertyChanged}" />
            </StackPanel>
        </Grid>
    </StackPanel>
</UserControl>
