<Window x:Class="OLED_Sleeper.UI.Views.QuickPanelWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="OLED Sleeper snelmenu" Width="380" SizeToContent="Height"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" ShowInTaskbar="False" Topmost="True" ShowActivated="False"
        WindowStartupLocation="Manual" FontFamily="Bahnschrift">

    <Window.Resources>
        <!-- One choice. Tag="sel" = currently highlighted (what happens when you let go). -->
        <Style x:Key="Item" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource SecondaryBackgroundColor}" />
            <Setter Property="BorderBrush" Value="{StaticResource SeparatorColorBrush}" />
            <Setter Property="BorderThickness" Value="1.5" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="14,9" />
            <Setter Property="Margin" Value="0,0,0,7" />
            <Setter Property="Cursor" Value="Hand" />
            <Style.Triggers>
                <Trigger Property="Tag" Value="sel">
                    <Setter Property="Background" Value="#1E3A5F" />
                    <Setter Property="BorderBrush" Value="{StaticResource AccentColorBrush}" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="Title" TargetType="TextBlock">
            <Setter Property="FontSize" Value="15" />
            <Setter Property="Foreground" Value="{StaticResource PrimaryForegroundColor}" />
        </Style>

        <Style x:Key="Sub" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11.5" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Margin" Value="0,2,0,0" />
            <Setter Property="Foreground" Value="{StaticResource SecondaryForegroundColor}" />
        </Style>

        <Style x:Key="Badge" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Foreground" Value="#4FC3F7" />
            <Setter Property="Margin" Value="8,0,0,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Visibility" Value="Collapsed" />
        </Style>

        <Style x:Key="Key" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource TertiaryBackgroundColor}" />
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="Width" Value="22" />
            <Setter Property="Height" Value="22" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
    </Window.Resources>

    <Border Background="{StaticResource PrimaryBackgroundColor}" BorderBrush="{StaticResource SeparatorColorBrush}"
            BorderThickness="1" CornerRadius="12" Padding="16" Margin="12">
        <Border.Effect>
            <DropShadowEffect BlurRadius="24" ShadowDepth="0" Opacity="0.6" />
        </Border.Effect>
        <StackPanel>
            <DockPanel Margin="2,0,0,12">
                <TextBlock Text="OLED Sleeper" FontSize="15" FontWeight="SemiBold" Foreground="{StaticResource PrimaryForegroundColor}" />
                <TextBlock x:Name="StatusText" FontSize="12" Foreground="{StaticResource SecondaryForegroundColor}"
                           HorizontalAlignment="Right" VerticalAlignment="Center" />
            </DockPanel>

            <Border x:Name="Item0" Style="{StaticResource Item}">
                <DockPanel>
                    <Border Style="{StaticResource Key}" DockPanel.Dock="Right"><TextBlock Text="1" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="12" Foreground="{StaticResource SecondaryForegroundColor}" /></Border>
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Bescherming aan" Style="{StaticResource Title}" />
                            <TextBlock x:Name="Active0" Text="● actief" Style="{StaticResource Badge}" />
                        </StackPanel>
                        <TextBlock Text="Stilstaande schermen gaan op zwart, dim of sterren" Style="{StaticResource Sub}" />
                    </StackPanel>
                </DockPanel>
            </Border>

            <Border x:Name="Item1" Style="{StaticResource Item}">
                <DockPanel>
                    <Border Style="{StaticResource Key}" DockPanel.Dock="Right"><TextBlock Text="2" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="12" Foreground="{StaticResource SecondaryForegroundColor}" /></Border>
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Werkmodus" Style="{StaticResource Title}" />
                            <TextBlock x:Name="Active1" Text="● actief" Style="{StaticResource Badge}" />
                        </StackPanel>
                        <TextBlock Text="Alle schermen blijven aan (video, lezen)" Style="{StaticResource Sub}" />
                    </StackPanel>
                </DockPanel>
            </Border>

            <Border x:Name="Item2" Style="{StaticResource Item}">
                <DockPanel>
                    <Border Style="{StaticResource Key}" DockPanel.Dock="Right"><TextBlock Text="3" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="12" Foreground="{StaticResource SecondaryForegroundColor}" /></Border>
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Werkmodus 1 uur" Style="{StaticResource Title}" />
                            <TextBlock x:Name="Active2" Text="● actief" Style="{StaticResource Badge}" />
                        </StackPanel>
                        <TextBlock Text="Daarna gaat de bescherming vanzelf weer aan" Style="{StaticResource Sub}" />
                    </StackPanel>
                </DockPanel>
            </Border>

            <Grid Margin="0,2,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="7" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border x:Name="Item3" Grid.Column="0" Style="{StaticResource Item}" Margin="0">
                    <DockPanel>
                        <Border Style="{StaticResource Key}" DockPanel.Dock="Right"><TextBlock Text="4" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="12" Foreground="{StaticResource SecondaryForegroundColor}" /></Border>
                        <TextBlock Text="Sterren bekijken" FontSize="13" VerticalAlignment="Center" Foreground="{StaticResource PrimaryForegroundColor}" />
                    </DockPanel>
                </Border>
                <Border x:Name="Item4" Grid.Column="2" Style="{StaticResource Item}" Margin="0">
                    <DockPanel>
                        <Border Style="{StaticResource Key}" DockPanel.Dock="Right"><TextBlock Text="5" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="12" Foreground="{StaticResource SecondaryForegroundColor}" /></Border>
                        <TextBlock Text="App openen" FontSize="13" VerticalAlignment="Center" Foreground="{StaticResource PrimaryForegroundColor}" />
                    </DockPanel>
                </Border>
            </Grid>

            <TextBlock x:Name="HintText" Margin="2,12,0,0" FontSize="11" TextWrapping="Wrap" Foreground="{StaticResource SecondaryForegroundColor}" />
        </StackPanel>
    </Border>
</Window>
