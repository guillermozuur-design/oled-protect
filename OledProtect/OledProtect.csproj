<Project Sdk="Microsoft.NET.Sdk">

  <!-- Target framework, WPF, nullable and implicit usings: see Directory.Build.props.
       Package versions: see Directory.Packages.props. -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <RootNamespace>OledProtect</RootNamespace>
    <ApplicationIcon>Assets\icon.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- Needed for source-generated P/Invoke ([LibraryImport]) and pointer-based interop. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <!-- The version is never written down: MinVer takes it from the nearest git tag such as v3.1.0. -->
    <MinVerTagPrefix>v</MinVerTagPrefix>
  </PropertyGroup>

  <!-- dotnet publish -p:Portable=true: the PORTABLE build keeps its data in a folder beside the exe. -->
  <PropertyGroup Condition=" '$(Portable)' == 'true' ">
    <DefineConstants>PORTABLE;$(DefineConstants)</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="MinVer" PrivateAssets="all" />
    <PackageReference Include="CommandLineParser" />
    <PackageReference Include="Hardcodet.NotifyIcon.Wpf" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
    <PackageReference Include="Microsoft.Extensions.Options" />
    <PackageReference Include="Serilog" />
    <PackageReference Include="Serilog.Sinks.File" />
  </ItemGroup>

  <!-- The tray and window icon is loaded as a WPF resource (pack URI), not copied as a loose file. -->
  <ItemGroup>
    <Resource Include="Assets\icon.ico" />
    <None Remove="@(Resource)" />
  </ItemGroup>

  <!-- Data compiled into the assembly, plus the licences of that third-party data next to the exe. -->
  <ItemGroup>
    <EmbeddedResource Include="Assets\Sky\sky.txt;Assets\Flights\airports.txt;Assets\Flights\countries.txt" />
    <None Update="Assets\Sky\LICENSE-d3-celestial.txt;Assets\Flights\LICENSE-OurAirports.txt" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
