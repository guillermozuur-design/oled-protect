<UserControl x:Class="OledProtect.UI.Views.MonitorConfigurationView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:behavior="clr-namespace:OledProtect.Features.MonitorBehavior.Models"
             xmlns:conv="clr-namespace:OledProtect.UI.Converters"
             xmlns:vm="clr-namespace:OledProtect.UI.ViewModels"             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:MonitorConfigurationViewModel}"
             d:DesignWidth="640"
             ToolTipService.InitialShowDelay="300"
             ToolTipService.ShowOnDisabled="True">

    <!--
        The panel for the screen picked in the overview. It reads top to bottom like the other tabs:
        a header with the on/off switch, then one block per question (what happens, after how long,
        what keeps the screen on). Each block names its own problem in red right where it is.
    -->
    <UserControl.Resources>
        <conv:EnumToBooleanConverter x:Key="IsBehavior" />
        <conv:TimeUnitToTextConverter x:Key="UnitName" />
        <conv:StringNullOrEmptyToVisibilityConverter x:Key="ShowWhenText" />

        <!-- Plain-text hover texts wrap instead of growing into one very wide line. -->
        <Style TargetType="ToolTip" BasedOn="{StaticResource {x:Type ToolTip}}">
            <Setter Property="ContentTemplate">
                <Setter.Value>
                    <DataTemplate>
                        <TextBlock Text="{Binding}" MaxWidth="320" TextWrapping="Wrap" />
                    </DataTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- One question of the panel: a rounded block, a shade darker than the card around it. -->
        <Style x:Key="Block" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource PrimaryBackgroundColor}" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Padding" Value="16,13,16,15" />
            <Setter Property="Margin" Value="0,0,0,10" />
        </Style>

        <!-- Title of an option inside a block: a bit smaller than a card title. -->
        <Style x:Key="OptionTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13.5" />
            <Setter Property="Foreground" Value="{StaticResource PrimaryForegroundColor}" />
        </Style>

        <!-- Thin divider between the options of one block. -->
        <Style x:Key="Divider" TargetType="Border">
            <Setter Property="Height" Value="1" />
            <Setter Property="Margin" Value="0,11" />
            <Setter Property="Background" Value="{StaticResource SeparatorColorBrush}" />
        </Style>

        <!-- Red note under a block that still needs something; hidden while the text is empty. -->
        <Style x:Key="ProblemNote" TargetType="Border">
            <Setter Property="Margin" Value="0,12,0,0" />
            <Setter Property="Padding" Value="9,5" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Background" Value="#2AFF5A6A" />
            <Setter Property="HorizontalAlignment" Value="Left" />
        </Style>

        <Style x:Key="ProblemText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Foreground" Value="{StaticResource DestructiveColorBrush}" />
        </Style>

        <!-- Behaviour choice as a row of pills; the chosen one is filled with the soft accent. -->
        <Style x:Key="Pill" TargetType="RadioButton">
            <Setter Property="GroupName" Value="IdleAction" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Margin" Value="0,0,8,8" />
            <Setter Property="Foreground" Value="{StaticResource SecondaryForegroundColor}" />
            <Setter Property="FocusVisualStyle" Value="{StaticResource AccentFocus}" />
            <Setter Property="ToolTipService.ShowOnDisabled" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Shape" CornerRadius="15" Padding="14,6" BorderThickness="1"
                                Background="{StaticResource TertiaryBackgroundColor}"
                                BorderBrush="{StaticResource SeparatorColorBrush}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="{StaticResource PrimaryForegroundColor}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Shape" Property="Background" Value="{StaticResource AccentSoftBrush}" />
                                <Setter TargetName="Shape" Property="BorderBrush" Value="{StaticResource AccentColorBrush}" />
                                <Setter Property="Foreground" Value="{StaticResource AccentColorBrush}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Shape" Property="Opacity" Value="0.4" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Brightness slider: a thin rail, the part up to the knob in accent, a small hollow knob. -->
        <Style x:Key="LevelRail" TargetType="Slider">
            <Setter Property="Minimum" Value="0" />
            <Setter Property="Maximum" Value="100" />
            <Setter Property="SmallChange" Value="1" />
            <Setter Property="LargeChange" Value="5" />
            <Setter Property="IsMoveToPointEnabled" Value="True" />
            <Setter Property="Focusable" Value="True" />
            <Setter Property="FocusVisualStyle" Value="{StaticResource AccentFocus}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Slider">
                        <Grid Height="22" Background="Transparent">
                            <Border Height="3" CornerRadius="1.5" VerticalAlignment="Center" Background="{StaticResource SeparatorColorBrush}" />
                            <Track x:Name="PART_Track">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="Slider.DecreaseLarge" Focusable="False">
                                        <RepeatButton.Template>
                                            <ControlTemplate TargetType="RepeatButton">
                                                <Border Background="Transparent">
                                                    <Border Height="3" CornerRadius="1.5" VerticalAlignment="Center" Background="{StaticResource AccentColorBrush}" />
                                                </Border>
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.DecreaseRepeatButton>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="Slider.IncreaseLarge" Focusable="False">
                                        <RepeatButton.Template>
                                            <ControlTemplate TargetType="RepeatButton">
                                                <Border Background="Transparent" />
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.IncreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Width="14" Height="14">
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Ellipse x:Name="Ring" Fill="{StaticResource PrimaryBackgroundColor}"
                                                         Stroke="{StaticResource AccentColorBrush}" StrokeThickness="2.5" />
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="Ring" Property="Fill" Value="{StaticResource AccentColorBrush}" />
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.35" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- The shared text field without WPF's red frame: the blocks show problems themselves. -->
        <Style x:Key="Amount" TargetType="TextBox" BasedOn="{StaticResource Field}">
            <Setter Property="Validation.ErrorTemplate" Value="{x:Null}" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
        </Style>

        <!-- Switches here never show WPF's error frame either. -->
        <Style x:Key="PanelSwitch" TargetType="CheckBox" BasedOn="{StaticResource Switch}">
            <Setter Property="Validation.ErrorTemplate" Value="{x:Null}" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="ToolTipService.ShowOnDisabled" Value="True" />
        </Style>
    </UserControl.Resources>

    <StackPanel Margin="20,18,20,10">

        <!-- ===== Header: which screen, and is it looked after at all ===== -->
        <DockPanel Margin="0,0,0,16">
            <CheckBox DockPanel.Dock="Right" Style="{StaticResource PanelSwitch}"
                      AutomationProperties.Name="Dit scherm bewaken"
                      IsChecked="{Binding IsManaged, UpdateSourceTrigger=PropertyChanged}"
                      ToolTip="Aan: OLED Protect let op dit scherm. Uit: het scherm gaat zijn eigen gang." />
            <StackPanel>
                <TextBlock Text="{Binding MonitorTitle}" FontSize="17" FontWeight="SemiBold"
                           Foreground="{StaticResource PrimaryForegroundColor}" TextTrimming="CharacterEllipsis" />
                <TextBlock Style="{StaticResource CardText}"
                           Text="Zet de schakelaar aan en dit scherm krijgt rust zodra je er even niet naar kijkt." />
            </StackPanel>
        </DockPanel>

        <StackPanel IsEnabled="{Binding IsManaged}">

            <!-- ===== What happens ===== -->
            <Border Style="{StaticResource Block}">
                <StackPanel>
                    <StackPanel ToolTip="{Binding BehaviorSectionTooltip}" Background="Transparent">
                        <TextBlock Style="{StaticResource CardTitle}" Text="Wat doet dit scherm als je weg bent?" />
                        <TextBlock Style="{StaticResource CardText}" Margin="0,3,0,10" Text="Kies er één; het gebeurt zodra de wachttijd om is." />
                        <WrapPanel>
                            <RadioButton Style="{StaticResource Pill}" Content="Zwart"
                                         IsChecked="{Binding Behavior, Converter={StaticResource IsBehavior}, ConverterParameter={x:Static behavior:MonitorBehaviorType.Blackout}, UpdateSourceTrigger=PropertyChanged}" />
                            <RadioButton Style="{StaticResource Pill}" Content="Dimmen"
                                         IsEnabled="{Binding IsDimBehaviorEnabled}"
                                         IsChecked="{Binding Behavior, Converter={StaticResource IsBehavior}, ConverterParameter={x:Static behavior:MonitorBehaviorType.Dim}, UpdateSourceTrigger=PropertyChanged}" />
                            <RadioButton Style="{StaticResource Pill}" Content="Sterrenhemel"
                                         ToolTip="Pikzwarte lucht met hier en daar een twinkelende of vallende ster."
                                         IsChecked="{Binding Behavior, Converter={StaticResource IsBehavior}, ConverterParameter={x:Static behavior:MonitorBehaviorType.Screensaver}, UpdateSourceTrigger=PropertyChanged}" />
                            <RadioButton Style="{StaticResource Pill}" Content="Vliegtuigen"
                                         ToolTip="Een donkere kaart die langzaam meedrijft met de vliegtuigen die er nu echt vliegen. Kies de plek in het tabblad Vliegtuigen."
                                         IsChecked="{Binding Behavior, Converter={StaticResource IsBehavior}, ConverterParameter={x:Static behavior:MonitorBehaviorType.Flights}, UpdateSourceTrigger=PropertyChanged}" />
                        </WrapPanel>
                    </StackPanel>

                    <Border Style="{StaticResource Divider}" />

                    <!-- Only meaningful for Dimmen: how bright the screen stays. -->
                    <DockPanel IsEnabled="{Binding IsDimSliderEnabled}">
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                            <Slider Style="{StaticResource LevelRail}" Width="170"
                                    AutomationProperties.Name="Helderheid bij dimmen"
                                    Value="{Binding DimLevel, UpdateSourceTrigger=PropertyChanged}" />
                            <TextBlock Width="44" Margin="10,0,0,0" VerticalAlignment="Center" TextAlignment="Right" FontSize="13.5"
                                       Foreground="{StaticResource PrimaryForegroundColor}"
                                       Text="{Binding DimLevel, StringFormat={}{0:F0}%}" />
                        </StackPanel>
                        <StackPanel Margin="0,0,16,0">
                            <TextBlock Style="{StaticResource OptionTitle}" Text="Gedimd tot" />
                            <TextBlock Style="{StaticResource CardText}" Text="Hoe fel het scherm nog is bij Dimmen." />
                        </StackPanel>
                    </DockPanel>

                    <Border Style="{StaticResource Divider}" />

                    <!-- Only meaningful for Zwart on a screen that takes brightness commands. -->
                    <DockPanel Background="Transparent" ToolTip="{Binding LowerBrightnessTooltip}" ToolTipService.ShowOnDisabled="True">
                        <CheckBox DockPanel.Dock="Right" Style="{StaticResource PanelSwitch}"
                                  AutomationProperties.Name="Bij zwart ook de helderheid op nul"
                                  IsEnabled="{Binding IsLowerBrightnessOptionEnabled}"
                                  IsChecked="{Binding LowerBrightnessOnBlackout, UpdateSourceTrigger=PropertyChanged}" />
                        <StackPanel Margin="0,0,16,0">
                            <TextBlock Style="{StaticResource OptionTitle}" Text="Bij Zwart ook het licht uit" />
                            <TextBlock Style="{StaticResource CardText}" Text="Het scherm zelf gaat dan naar helderheid 0." />
                        </StackPanel>
                    </DockPanel>

                    <Border Style="{StaticResource ProblemNote}" Visibility="{Binding BehaviorError, Converter={StaticResource ShowWhenText}}">
                        <TextBlock Style="{StaticResource ProblemText}" Text="{Binding BehaviorError}" />
                    </Border>
                </StackPanel>
            </Border>

            <!-- ===== After how long ===== -->
            <Border Style="{StaticResource Block}">
                <StackPanel>
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBox Style="{StaticResource Amount}" Width="64"
                                     AutomationProperties.Name="Wachttijd"
                                     Text="{Binding IdleValue, UpdateSourceTrigger=PropertyChanged, TargetNullValue=''}" />
                            <ComboBox Width="112" Margin="8,0,0,0" FontSize="13.5"
                                      AutomationProperties.Name="Eenheid van de wachttijd"
                                      ItemsSource="{Binding TimeUnits}"
                                      SelectedItem="{Binding SelectedTimeUnit, UpdateSourceTrigger=PropertyChanged}">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Converter={StaticResource UnitName}}" />
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                        </StackPanel>
                        <StackPanel Margin="0,0,16,0">
                            <TextBlock Style="{StaticResource CardTitle}" Text="Wachttijd" />
                            <TextBlock Style="{StaticResource CardText}" Text="Zo lang blijft het rustig op dit scherm voordat het aan de beurt is." />
                        </StackPanel>
                    </DockPanel>

                    <Border Style="{StaticResource ProblemNote}" Visibility="{Binding IdleValueError, Converter={StaticResource ShowWhenText}}">
                        <TextBlock Style="{StaticResource ProblemText}" Text="{Binding IdleValueError}" />
                    </Border>
                </StackPanel>
            </Border>

            <!-- ===== What keeps it on ===== -->
            <Border Style="{StaticResource Block}">
                <StackPanel>
                    <StackPanel Background="Transparent">
                        <StackPanel.ToolTip>
                            <TextBlock MaxWidth="320" TextWrapping="Wrap">
                                Staat er minstens één aan die klopt, dan blijft dit scherm gewoon aan.<LineBreak /><LineBreak />
                                Muis en venster kijken alleen naar dít scherm: zo kan het scherm naast je al rusten terwijl jij hier werkt.<LineBreak /><LineBreak />
                                Ergens muis of toetsenbord kijkt naar al je schermen samen, net als de slaapstand van Windows.
                            </TextBlock>
                        </StackPanel.ToolTip>
                        <TextBlock Style="{StaticResource CardTitle}" Text="Wakker houden als…" />
                        <TextBlock Style="{StaticResource CardText}" Text="Zolang één van deze klopt, wacht dit scherm nog even." />
                    </StackPanel>

                    <Border Style="{StaticResource Divider}" />

                    <DockPanel>
                        <CheckBox DockPanel.Dock="Right" Style="{StaticResource PanelSwitch}"
                                  AutomationProperties.Name="Je muis staat op dit scherm"
                                  IsChecked="{Binding IsActiveOnMousePosition, UpdateSourceTrigger=PropertyChanged}" />
                        <StackPanel Margin="0,0,16,0">
                            <TextBlock Style="{StaticResource OptionTitle}" Text="…je muis hier staat" />
                            <TextBlock Style="{StaticResource CardText}" Text="Ook als je hem niet beweegt." />
                        </StackPanel>
                    </DockPanel>

                    <DockPanel Margin="0,12,0,0">
                        <CheckBox DockPanel.Dock="Right" Style="{StaticResource PanelSwitch}"
                                  AutomationProperties.Name="Je venster staat op dit scherm"
                                  IsChecked="{Binding IsActiveOnActiveWindow, UpdateSourceTrigger=PropertyChanged}" />
                        <StackPanel Margin="0,0,16,0">
                            <TextBlock Style="{StaticResource OptionTitle}" Text="…het venster waar je in werkt hier staat" />
                            <TextBlock Style="{StaticResource CardText}" Text="Het venster dat je het laatst aanklikte." />
                        </StackPanel>
                    </DockPanel>


                    <Border Style="{StaticResource Divider}" />

                    <DockPanel>
                        <CheckBox DockPanel.Dock="Right" Style="{StaticResource PanelSwitch}"
                                  AutomationProperties.Name="Je gebruikt ergens muis of toetsenbord"
                                  IsChecked="{Binding IsActiveOnInput, UpdateSourceTrigger=PropertyChanged}" />
                        <StackPanel Margin="0,0,16,0">
                            <TextBlock Style="{StaticResource OptionTitle}" Text="…je ergens muis of toetsenbord gebruikt" />
                            <TextBlock Style="{StaticResource CardText}" Text="Op welk scherm dan ook." />
                        </StackPanel>
                    </DockPanel>

                    <Border Style="{StaticResource ProblemNote}" Visibility="{Binding ActiveConditionsError, Converter={StaticResource ShowWhenText}}">
                        <TextBlock Style="{StaticResource ProblemText}" Text="{Binding ActiveConditionsError}" />
                    </Border>
                </StackPanel>
            </Border>
        </StackPanel>
    </StackPanel>
</UserControl>
