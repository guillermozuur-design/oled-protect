<UserControl x:Class="OledProtect.UI.Views.MonitorLayoutView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:conv="clr-namespace:OledProtect.UI.Converters"
             xmlns:vm="clr-namespace:OledProtect.UI.ViewModels"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:MainViewModel}"
             d:DesignWidth="800" d:DesignHeight="450"
             ToolTipService.InitialShowDelay="200"
             x:Name="Overview"
             SizeChanged="OnPanelResized">

    <!-- Overview of all screens as scaled tiles; clicking a tile opens its settings below. -->
    <UserControl.Resources>
        <conv:LeftTopToMarginConverter x:Key="PositionToMargin" />
        <conv:BooleanToVisibilityConverter x:Key="ShowWhenTrue" />

        <Style x:Key="ScreenTile" TargetType="Border">
            <Setter Property="CornerRadius" Value="5" />
            <Setter Property="HorizontalAlignment" Value="Left" />
            <Setter Property="VerticalAlignment" Value="Top" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="2" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect BlurRadius="12" ShadowDepth="2" Opacity="0.45" Color="Black" />
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="BorderBrush" Value="{StaticResource AccentColorBrush}" />
                </Trigger>
                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                    <Setter Property="BorderBrush" Value="{StaticResource AccentColorBrush}" />
                    <Setter Property="BorderThickness" Value="3" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="RoundIconButton" TargetType="Button">
            <Setter Property="Width" Value="30" />
            <Setter Property="Height" Value="30" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Foreground" Value="{StaticResource SecondaryForegroundColor}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="FontFamily" Value="Segoe MDL2 Assets" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <Ellipse Fill="{TemplateBinding Background}" />
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{StaticResource TertiaryBackgroundColor}" />
                    <Setter Property="Foreground" Value="{StaticResource PrimaryForegroundColor}" />
                </Trigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Border Background="{StaticResource SecondaryBackgroundColor}" CornerRadius="8">
        <Grid>
            <ItemsControl ItemsSource="{Binding Monitors}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <!-- Tiles are placed by margin inside one cell, matching the desktop arrangement. -->
                        <Grid ClipToBounds="True" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type vm:MonitorLayoutViewModel}">
                        <Border Style="{StaticResource ScreenTile}"
                                Width="{Binding ScaledWidth}"
                                Height="{Binding ScaledHeight}"
                                Background="{Binding BackgroundColor}">
                            <Border.Margin>
                                <MultiBinding Converter="{StaticResource PositionToMargin}">
                                    <Binding Path="ScaledLeft" />
                                    <Binding Path="ScaledTop" />
                                </MultiBinding>
                            </Border.Margin>
                            <Border.InputBindings>
                                <MouseBinding MouseAction="LeftClick"
                                              Command="{Binding DataContext.SelectMonitorCommand, ElementName=Overview}"
                                              CommandParameter="{Binding}" />
                            </Border.InputBindings>

                            <Grid>
                                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <TextBlock HorizontalAlignment="Center" Text="{Binding MonitorTitle}"
                                               FontSize="16" FontWeight="SemiBold"
                                               Foreground="{StaticResource PrimaryForegroundColor}" />
                                    <TextBlock HorizontalAlignment="Center" Margin="0,2,0,0" Text="{Binding ResolutionText}"
                                               FontSize="12" Foreground="{StaticResource SecondaryForegroundColor}" />
                                </StackPanel>

                                <!-- Amber dot: this screen has edits that are not written yet. -->
                                <Ellipse Width="10" Height="10" Margin="0,6,6,0"
                                         VerticalAlignment="Top" HorizontalAlignment="Right"
                                         Fill="#F5A623"
                                         Visibility="{Binding IsDirty, Converter={StaticResource ShowWhenTrue}}"
                                         ToolTip="Dit scherm heeft wijzigingen die nog worden opgeslagen." />
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <TextBlock Text="Jouw schermen" Margin="15,10,0,0"
                       HorizontalAlignment="Left" VerticalAlignment="Top" IsHitTestVisible="False"
                       FontSize="14" FontWeight="Light" Foreground="{StaticResource SecondaryForegroundColor}" />

            <!-- E72C is the Refresh glyph in Segoe MDL2 Assets. -->
            <Button Style="{StaticResource RoundIconButton}" Content="&#xE72C;"
                    HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,8,8,0"
                    Command="{Binding ReloadMonitorsCommand}"
                    ToolTip="Schermen opnieuw zoeken" />
        </Grid>
    </Border>
</UserControl>
