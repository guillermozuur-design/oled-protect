<Window x:Class="OledProtect.UI.Views.QuickPanelWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="OLED Protect snelmenu" Width="280" SizeToContent="Height"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" ShowInTaskbar="False" Topmost="True" ShowActivated="False"
        WindowStartupLocation="Manual" FontFamily="Bahnschrift">

    <Window.Resources>
        <!-- One row. Tag="sel" = highlighted (what happens when you let go / what the mouse is on). -->
        <Style x:Key="Row" TargetType="Border">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Padding" Value="10,0" />
            <Setter Property="Height" Value="36" />
            <Setter Property="Margin" Value="0,1" />
            <Setter Property="Cursor" Value="Hand" />
            <Style.Triggers>
                <Trigger Property="Tag" Value="sel">
                    <Setter Property="Background" Value="#1A1F2B" />
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Border x:Name="Card" Background="#0C0E12" BorderBrush="{StaticResource SeparatorColorBrush}"
            BorderThickness="1" CornerRadius="10" Padding="6" Margin="12">
        <Border.Effect>
            <DropShadowEffect BlurRadius="24" ShadowDepth="0" Opacity="0.6" />
        </Border.Effect>
        <StackPanel>
            <StackPanel x:Name="Rows" />
            <TextBlock x:Name="HintText" Margin="10,6,10,3" FontSize="10.5" TextAlignment="Center"
                       TextWrapping="Wrap" Foreground="#5B6170" />
        </StackPanel>
    </Border>
</Window>
