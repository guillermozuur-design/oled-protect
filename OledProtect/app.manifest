<?xml version="1.0" encoding="utf-8"?>
<!-- OLED Protect: runs without elevation and handles DPI per monitor itself,
     so overlays line up exactly on mixed-DPI multi-monitor setups. -->
<assembly xmlns="urn:schemas-microsoft-com:asm.v1" manifestVersion="1.0">
  <assemblyIdentity name="OledProtect.app" version="1.0.0.0" />

  <trustInfo xmlns="urn:schemas-microsoft-com:asm.v2">
    <security>
      <requestedPrivileges xmlns="urn:schemas-microsoft-com:asm.v3">
        <requestedExecutionLevel uiAccess="false" level="asInvoker" />
      </requestedPrivileges>
    </security>
  </trustInfo>

  <application xmlns="urn:schemas-microsoft-com:asm.v3">
    <windowsSettings>
      <!-- .NET 8 needs Windows 10 1607+, which reads dpiAwareness, so the legacy dpiAware element is not needed. -->
      <dpiAwareness xmlns="http://schemas.microsoft.com/SMI/2016/WindowsSettings">PerMonitorV2, PerMonitor</dpiAwareness>
    </windowsSettings>
  </application>
</assembly>
